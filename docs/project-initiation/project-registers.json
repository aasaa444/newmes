    {"id": "IF-003", "name": "ProductionOrderUpsert", "direction": "ERP -> MES", "object": "生产订单", "trigger": "创建/受控变更", "idempotency": "SourceSystem + OrderNo + SourceVersion", "ack": "Accepted/Rejected/ChangeRequired", "status": "Contract Candidate"},
    {"id": "IF-004", "name": "MaterialTransferNotice", "direction": "ERP/WMS -> MES", "object": "物料交接", "trigger": "线边交接", "idempotency": "TransferNo + LineNo", "ack": "Received/Rejected", "status": "To Validate"},
    {"id": "IF-005", "name": "ProductionCompletion", "direction": "MES -> ERP", "object": "合格完工", "trigger": "每 SN 或汇总", "idempotency": "CompletionEventId", "ack": "Posted/Rejected", "status": "Contract Candidate"},
    {"id": "IF-006", "name": "MaterialConsumption", "direction": "MES -> ERP", "object": "耗用/冲正", "trigger": "实际耗用或结算", "idempotency": "MaterialTransactionId", "ack": "Posted/Rejected", "status": "Contract Candidate"},
    {"id": "IF-007", "name": "ScrapDeclaration", "direction": "MES -> ERP", "object": "报废", "trigger": "报废处置完成", "idempotency": "ScrapEventId", "ack": "Posted/Rejected", "status": "To Validate"},
    {"id": "IF-008", "name": "WarehouseHandoff", "direction": "MES <-> WMS/仓储", "object": "成品交接", "trigger": "完工后交接", "idempotency": "HandoffEventId", "ack": "Received/Rejected", "status": "To Validate"}
  ],
