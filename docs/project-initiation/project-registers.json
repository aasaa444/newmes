  "raid": [
    {"id": "RISK-001", "type": "Risk", "description": "无真实制造专家导致业务规则失真", "probability": "High", "impact": "High", "owner": "MES项目经理", "response": "公开证据分级；可配置；从业者评审门禁", "status": "Open"},
