  "interfaces": [
    {"id": "IF-001", "name": "ProductMasterUpsert", "direction": "ERP -> MES", "object": "产品与单位", "trigger": "新增/变更", "idempotency": "SourceSystem + MessageId", "ack": "Accepted/Rejected", "status": "Contract Candidate"},
