    {"id": "UAT-004", "scenario": "集成重复、失败、重试与对账", "roles": "计划/ERP/IT", "requirements": "FR-INT,FR-PO,FR-CMP", "expected": "无重复业务结果，失败可恢复，对账前不能关闭", "status": "Not Run"}
